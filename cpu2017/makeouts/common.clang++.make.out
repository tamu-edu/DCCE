BC_DIR=$1
BIN_DIR=$2
RTLIB_DIR=$3
BENCH=$4

llvm-dis ${BC_DIR}/${BENCH}.bc
#/home/sungkeun/packages/llvm-project-llvmorg-10.0.0/build/bin/clang++ ${BC_DIR}/${BENCH}.bc \
clang++ ${BC_DIR}/${BENCH}.bc \
        -pg \
        -m64 \
        -z muldefs \
        -O3 \
        -mavx \
        -DSPEC_LINUX_X64 \
        -DSPEC_OPENMP \
        -fopenmp \
        -Wno-return-type \
        -DUSE_OPENMP \
        -lm \
        -fopenmp=libomp \
        -L/home/sungkeun/packages/llvm-project-llvmorg-10.0.0/build/lib -lomp \
        -L ${RTLIB_DIR}/build -lrtlib \
        -o ${BIN_DIR}/${BENCH}
