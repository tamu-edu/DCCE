    def find_backedges(self):
        eb2c = {}
        for cycle in self.cycles:
            logging.debug('find backes for cycle')
            logging.debug(cycle)
            for idx_n, node in enumerate(cycle):
                logging.debug('checking %s' % node)
                for incident, ics in self.cg.incidents(node):
                    if incident not in cycle:
                        logging.debug('      backedge %s %s' % (incident, ics))
                        backedges = self.get_edges(cycle[idx_n-1], node)
                        if ics not in eb2c:
                            eb2c[ics] = {}
                        for backedge in backedges:
                            if backedge not in eb2c[ics]:
                                eb2c[ics][backedge] = []
                            eb2c[ics][backedge].append(cycle)
        return eb2c


    def get_edges(self, fr, to):
        logging.debug('        getting edges from %s to %s' % (fr, to))
        edges = []
        for caller, (callee, callsite) in self.cg.edges():
            if caller == fr and callee == to:
                logging.debug('found edge %s %s %s' % (caller, callee, callsite))
                edges.append(callsite)
        return edges

    def get_stats(self):
        return [len(self.cg.nodes()), len(self.cg.edges()), len(self.scc_orig), len(self.cycles)]

    def write_cycles(self):
        outfile = '%s/%s.cycles' % (self.outdir, self.bench)
        f = open(outfile, 'w')
        f.write('printing cycles ...\n')
        for entryedge, b2c in self.eb2c.items():
            for backedge, cycles in b2c.items():
                for cycle in cycles:
                    f.write('[%s : %s]' % (entryedge, backedge))
                    for n in cycle:
                        f.write(n + ' ')
                    f.write('\n')
        f.write('printing scc_orig ...\n')
        for components in self.scc_orig:
            for n in components:
                f.write('%s ' % n)
            f.write('\n')
        f.write('printing scc ...\n')
        for components in self.scc:
            for n in components:
                f.write('%s ' % n)
            f.write('\n')
        f.close()

    def render_callgraph(self):
        dot = Digraph()
        for node in self.cg.nodes():
            dot.node(node, label=node)

        for caller, (callee, callsite) in self.cg.edges():
            wt = self.cg.edge_weight((caller,callee,callsite))
            dot.edge(caller, callee,
                    label=callsite+':'+str(wt))

        ## create dot file and render it
        outfile = '%s/%s.dot' % (self.outdir, self.bench)
        dot.save(outfile)
        dot.render(outfile, view=False)



