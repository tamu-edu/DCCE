class CGAnalyzer:
    def __init__(self, cg, bench, outdir):
        self.cg = cg
        self.bench = bench
        self.outdir = outdir
        self.cycles, self.scc_orig, self.scc = self.find_cycles()
        # cycle -> (entry edge, back edge)
        self.eb2c = self.find_backedges()

    def find_cycles(self):
        adj_list = {}
        for node in self.cg.nodes():
            adj_list[node] = []
            for neighbor, callsite in self.cg.neighbors(node):
                adj_list[node].append(neighbor)

        return simple_cycles(adj_list)



