output_root = '../output/dcce/ccenc/'

def get_data(args, bench):
    file = '%s/%s.conn' % (output_root, bench)
    neighbors = []
    incidents = []
    with open(file, 'r') as f:
        for line in f:
            node, n_i = line.strip().split(':')
            n ,i = n_i.split(',')
            n = int(n)
            i = int(i)
            neighbors.append(n)
            incidents.append(i)

    return neighbors, incidents


def main(args):

    for bench in benches:
        print('processing %s' % (bench))
        neighbors, incidents = get_data(args, bench)

        df = pd.DataFrame({'%s-neighbors' % bench: neighbors})
