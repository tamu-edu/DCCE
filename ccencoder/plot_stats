#!/usr/bin/python3
import argparse
import os
import pandas

benches = [
    '600.perlbench_s', # cannot run instrument because of integer overflow
    '602.gcc_s',      # compile issue
    '605.mcf_s',
    #'607.cactuBSSN_s',# compile issue
    '619.lbm_s',
    '620.omnetpp_s',  # assertion during dump-callgraph lineno: 356
    '623.xalancbmk_s',# assertion during dump-callgraph lineno: 356
    '625.x264_s',
    '631.deepsjeng_s',
    '638.imagick_s',
    '641.leela_s',   # assertion during dump-callgraph lineno: 356
    '644.nab_s',
    '657.xz_s',
    '998.specrand_is',
    'test',
    ]

output_root = '../output/dcce/ccenc/'

def get_maxccid(bench):
    file = '%s/%s.maxid' % (output_root, bench)
    f = open(file, 'r')
    return f.readline().strip()

def get_ncycles(bench):
    file = '%s/%s.backedge' % (output_root, bench)
    nlines = 0
    with open(file, 'r') as f:
        for line in f:
            nlines += 1
    return nlines

def get_nfptr_maxjmps(bench):
    file = '%s/%s.funcptr' % (output_root, bench)
    nlines = 0
    max_jmps = 0
    with open(file, 'r') as f:
        for line in f:
            nlines += 1
            n_jmps = int(line.strip().split(':')[1].strip())
            if n_jmps > max_jmps:
                max_jmps = n_jmps
    return nlines, max_jmps

def get_num_callsite(bench):
    file = '%s/%s.cc' % (output_root, bench)
    nlines = 0
    with open(file, 'r') as f:
        for line in f:
            nlines += 1
    return nlines

def get_max_neighbors(bench):
    file = '%s/%s.maxneighbors' % (output_root, bench)
    f = open(file, 'r')
    return int(f.readline().strip())

def collect_stats(bench):
    maxccid = get_maxccid(bench)
    n_cycles = get_ncycles(bench)
    n_fptr, n_jmp_tgt = get_nfptr_maxjmps(bench)
    n_callsites = get_num_callsite(bench)
    max_neighbors = get_max_neighbors(bench)

    return [maxccid, n_callsites, n_cycles, n_fptr, n_jmp_tgt, max_neighbors]



def main(args):
    headers = ['MaxCCID', '# callsites', '# Cycles', '# FuncPtr', 'Max Jump Tgts', 'Max Neighbors']
    idx = []
    data = []
    if args.bench == 'all':
        for bench in benches:
            idx.append(bench)
            data.append(collect_stats(bench))
    else:
        idx.append(args.bench)
        data.append(collect_stats(args.bench))
    df = pandas.DataFrame(data, columns = headers, index= idx)
    print(df)



if __name__== "__main__":
    parser = argparse.ArgumentParser(\
            description="A program to plot stats generated by cc_encoder")

    parser.add_argument('-b', '--bench',
            type=str, default='all',
            help='benchmarks (default: %(default)s)')

    args = parser.parse_args()
    main(args)
